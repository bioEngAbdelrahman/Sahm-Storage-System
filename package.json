{
  "name": "medical-hub",
  "version": "1.0.0",
  "description": "سهم ميدكال | إدارة الأجهزة الطبية والمخازن",
  "author": "سهم ميدكال",
  "main": "electron-main.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "desktop": "electron .",
    "build:desktop": "ng build && electron .",
    "pack:exe": "electron-builder --win portable",
    "dist": "npm run build && electron-builder --win portable",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/platform-browser-dynamic": "^22.2.1",
    "@angular/router": "^22.2.1",
    "@lucide/angular": "^1.51.0",
    "dexie": "^4.4.6",
    "jsbarcode": "^3.12.3",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "xlsx": "^0.18.5",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.1",
    "@types/jasmine": "~5.1.0",
    "@types/jsbarcode": "^3.11.4",
    "@types/qrcode": "^1.5.6",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.6.0",
    "javascript-obfuscator": "^5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~6.0.3"
  },
  "build": {
    "appId": "com.sahmmedical.erp",
    "productName": "Sahm Medical",
    "npmRebuild": false,
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/medical-hub/browser/**/*",
      "electron-main.js",
      "package.json",
      "favicon.ico"
    ],
    "win": {
      "icon": "favicon.ico",
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "Sahm Medical.exe"
    }
  }
}
